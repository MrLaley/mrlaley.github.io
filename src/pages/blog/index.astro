---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Blog Categories - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main { max-width: 960px; width: 100%; margin: auto; padding: 3em 1em; }
			.grid-sections { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-top: 2rem; }
			.block h2 { margin: 0 0 1rem 0; color: var(--accent); }
			.block p { margin: 0; line-height: 1.5; }
			@media (max-width: 720px) {
				.grid-sections { grid-template-columns: 1fr; gap: 1.5rem; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Blog Categories</h1>
			<p>Select a category to read articles and insights:</p>
			
			<div class="grid-sections">
				<a href="/blog/computer-science" class="clickable-card block">
					<h2>Computer Science</h2>
					<p>Articles about software engineering, algorithms, architectures, and technology.</p>
				</a>
				<a href="/blog/sports" class="clickable-card block">
					<h2>Sports</h2>
					<p>Insights, analysis, and thoughts on various sports and athletic performance.</p>
				</a>
			</div>
		</main>
		<Footer />
	</body>
</html>
