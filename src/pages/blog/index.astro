---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Blog Categories - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main { max-width: 960px; margin: auto; padding: 3em 1em; font-family: sans-serif; }
			.grid-sections { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-top: 2rem; }
			.block { background-color: #f8f9fa; padding: 2rem; border-radius: 12px; text-align: center; text-decoration: none; color: #1a1a1a; transition: transform 0.2s, box-shadow 0.2s; border: 1px solid #eaeaea; }
			.block:hover { transform: translateY(-5px); box-shadow: 0 10px 20px rgba(0,0,0,0.05); }
			.block h2 { margin: 0 0 1rem 0; color: #0055ff; }
			.block p { margin: 0; color: #666; line-height: 1.5; }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Blog Categories</h1>
			<p>Select a category to read articles and insights:</p>
			
			<div class="grid-sections">
				<a href="/blog/computer-science" class="block">
					<h2>Computer Science</h2>
					<p>Articles about software engineering, algorithms, architectures, and technology.</p>
				</a>
				<a href="/blog/sports" class="block">
					<h2>Sports</h2>
					<p>Insights, analysis, and thoughts on various sports and athletic performance.</p>
				</a>
			</div>
		</main>
		<Footer />
	</body>
</html>
