---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION } from '../../consts';

export async function getStaticPaths() {
	return [
		{ params: { category: 'computer-science' } },
		{ params: { category: 'sports' } }
	];
}

const { category } = Astro.params;
const allPosts = await getCollection('blog');
const filteredPosts = allPosts
    .filter((post) => post.data.category === category)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categoryTitle = category === 'computer-science' ? 'Computer Science' : 'Sports';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${categoryTitle} Blog`} description={SITE_DESCRIPTION} />
		<style>
			main {
				max-width: 960px;
				width: 100%;
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li:first-child {
				width: 100%;
				margin-bottom: 1rem;
				text-align: center;
			}
			ul li:first-child img {
				width: 100%;
			}
			ul li:first-child .title {
				font-size: 2.369rem;
			}
			ul li img {
				margin-bottom: 0.5rem;
				border-radius: 12px;
			}
			ul li a {
				display: block;
			}
			.title {
				margin: 0;
				color: var(--heading-color);
				line-height: 1;
			}
			.date {
				margin: 0;
				color: var(--text-color);
			}
			ul li a:hover h4,
			ul li a:hover .date {
				color: var(--accent);
			}
			ul a:hover img {
				box-shadow: var(--box-shadow);
			}
            .back-link {
                display: inline-block;
                margin-bottom: 2rem;
                color: var(--accent);
                text-decoration: none;
                font-weight: bold;
            }
			.empty-state {
				text-align: center;
				padding: 3rem 1.5rem;
				border: 1px dashed var(--gray-border);
				border-radius: 12px;
				background: var(--panel-bg);
				color: var(--gray);
				margin-top: 1.5rem;
			}
			.empty-state p {
				margin: 0;
				font-size: 1.1rem;
			}
			@media (max-width: 720px) {
				ul {
					gap: 1.5em;
				}
				ul li {
					width: 100%;
					text-align: center;
				}
				ul li:first-child {
					margin-bottom: 0;
				}
				ul li:first-child .title {
					font-size: 1.563em;
				}
				.back-link {
					margin-bottom: 1.5rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
            <a href="/blog" class="back-link">&larr; Back to Categories</a>
			<h1>{categoryTitle} Articles</h1>
			<section>
				{filteredPosts.length === 0 ? (
					<div class="empty-state">
						<p>No articles published in this category yet. Check back soon!</p>
					</div>
				) : (
					<ul>
						{
							filteredPosts.map((post) => (
								<li>
									<a href={`/blog/${post.id}/`}>
										{post.data.heroImage && (
											<Image width={720} height={360} src={post.data.heroImage} alt="" />
										)}
										<h4 class="title">{post.data.title}</h4>
										<p class="date">
											<FormattedDate date={post.data.pubDate} />
										</p>
									</a>
								</li>
							))
						}
					</ul>
				)}
			</section>
		</main>
		<Footer />
	</body>
</html>
