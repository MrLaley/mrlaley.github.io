---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
	return [
		{ params: { category: 'individual' } },
		{ params: { category: 'university' } }
	];
}

const { category } = Astro.params;
const allProjects = (await getCollection('projects')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const filteredProjects = allProjects.filter((project) => project.data.category === category);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${category.charAt(0).toUpperCase() + category.slice(1)} Projects`} description="List of my projects" />
		<style>
			main { max-width: 960px; width: 100%; margin: auto; padding: 3em 1em; }
			ul { list-style-type: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 2rem; }
			li { border-radius: 12px; overflow: hidden; }
			a { text-decoration: none; color: inherit; display: flex; flex-direction: column; height: 100%; }
			.card-image { width: 100%; height: 200px; object-fit: cover; border-bottom: 1px solid var(--gray-border); }
			.card-content { padding: 1.5rem; flex-grow: 1; }
			h4 { margin: 0 0 0.5rem 0; font-size: 1.2rem; color: var(--heading-color); }
			p { margin: 0; font-size: 0.95rem; }
			.back-link { display: inline-block; margin-bottom: 2rem; color: var(--accent); text-decoration: none; font-weight: bold; }
			@media (max-width: 720px) {
				ul {
					grid-template-columns: 1fr;
					gap: 1.5rem;
				}
				.back-link {
					margin-bottom: 1.5rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<a href="/projects" class="back-link">&larr; Back to Categories</a>
			<h1>{category.charAt(0).toUpperCase() + category.slice(1)} Projects</h1>
			<ul>
				{filteredProjects.map((project) => (
					<li class="clickable-card" style="padding: 0; margin-bottom: 0;">
						<a href={`/projects/${project.id}/`}>
							{project.data.heroImage && (
								<Image src={project.data.heroImage} alt="" width={600} height={300} class="card-image" />
							)}
							<div class="card-content">
								<h4>{project.data.title}</h4>
								<p>{project.data.description}</p>
							</div>
						</a>
					</li>
				))}
			</ul>
		</main>
		<Footer />
	</body>
</html>