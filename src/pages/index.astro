---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				display: flex;
				align-items: center;
				gap: 2rem;
				margin-bottom: 2rem;
			}
			.hero img {
				width: 250px;
				height: 250px;
				border-radius: 50%;
				object-fit: cover;
				box-shadow: var(--box-shadow);
			}
			.hero-content {
				flex: 1;
			}
			.skills-list {
				margin-top: 1rem;
				padding-left: 1.5rem;
			}
			.skills-list li {
				margin-bottom: 0.5rem;
			}
			@media (max-width: 768px) {
				.hero {
					flex-direction: column-reverse;
					text-align: center;
				}
			}
			.gradient-text {
				background: linear-gradient(135deg, #007bff 0%, #00ff88 100%);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
				display: inline-block;
			}
			.subtitle {
				font-size: 1.2rem;
				color: var(--gray);
				margin-bottom: 1rem;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<!-- NOTE: To update this image, place your photo as 'profile.jpg' in the 'public/' directory -->
				<img src="/profile.jpg" alt="Jaime Molina" />
				<div class="hero-content">
					<h1 class="gradient-text">Jaime Molina</h1>
					<div class="subtitle">Engineer | Developer | Team Coordinator</div>
					<p>
						<strong>Technical Computer Science Student</strong> at University of Twente | Software Engineering & Systems | Full-Stack & Low-Level Programming | Cybersecurity Enthusiast.
					</p>
					<p>
						Originally from Spain with a global mindset. My education is centered on solving complex engineering challenges through project-based learning.
					</p>
				</div>
			</section>

			<section>
				<h3>Top Skills & Experience</h3>
				<ul class="skills-list">
					<li><strong>Software & Systems:</strong> Experienced in designing distributed and concurrent systems in Java, as well as low-level programming (C/Assembly) with direct hardware control.</li>
					<li><strong>AI & Machine Learning:</strong> Integrating machine learning capabilities to develop intelligent systems and predictive models.</li>
					<li><strong>Cybersecurity:</strong> A solid foundation in ethical hacking, focused on network infrastructure protection and data integrity.</li>
					<li><strong>Methodologies:</strong> Applying Agile (Scrum) methodologies and algorithmic efficiency principles to deliver secure, scalable, and high-performance solutions.</li>
					<li><strong>Algorithms:</strong> Specialized in efficient algorithm design and graph theory, specifically working on solving NP-complete problems.</li>
					<li><strong>Leadership & Organization:</strong> Strong capacity for teamwork, mediation, and conflict resolution in multicultural environments. Decisive and proactive in organizing workflows that maximize group efficiency.</li>
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
